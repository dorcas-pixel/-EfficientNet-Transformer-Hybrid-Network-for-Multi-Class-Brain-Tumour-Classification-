def explain_with_gradcam(image_path):

    image = Image.open(
        image_path
    ).convert("RGB")

    original_image = np.array(
        image.resize(
            (IMG_SIZE, IMG_SIZE)
        )
    )

    image_tensor = test_transform(
        image
    ).unsqueeze(0)

    image_tensor = image_tensor.to(
        DEVICE
    )

    # Last EfficientNet convolutional layer
    target_layer = model.efficientnet.features[-1]

    gradcam = GradCAM(
        model,
        target_layer
    )

    cam, predicted_class = gradcam.generate(
        image_tensor
    )

    gradcam.remove_hooks()

    predicted_label = class_names[
        predicted_class
    ]

    # Convert CAM into heatmap
    heatmap = np.uint8(
        255 * cam
    )

    heatmap = cv2.applyColorMap(
        heatmap,
        cv2.COLORMAP_JET
    )

    heatmap = cv2.cvtColor(
        heatmap,
        cv2.COLOR_BGR2RGB
    )

    # Overlay
    overlay = (
        0.6 * original_image +
        0.4 * heatmap
    )

    overlay = np.uint8(
        np.clip(
            overlay,
            0,
            255
        )
    )

    # Display
    plt.figure(figsize=(15, 5))

    plt.subplot(1, 3, 1)

    plt.imshow(original_image)

    plt.title("Original MRI")

    plt.axis("off")


    plt.subplot(1, 3, 2)

    plt.imshow(
        heatmap
    )

    plt.title("Grad-CAM")

    plt.axis("off")


    plt.subplot(1, 3, 3)

    plt.imshow(
        overlay
    )

    plt.title(
        f"Prediction: {predicted_label}"
    )

    plt.axis("off")

    plt.tight_layout()

    plt.show()



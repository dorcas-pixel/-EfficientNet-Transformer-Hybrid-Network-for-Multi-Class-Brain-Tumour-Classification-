import shap


# ============================================================
# SHAP EXPLAINER
# ============================================================

model.eval()


# Select a small background dataset
background_images = []

for images, labels in train_loader:

    background_images.append(
        images
    )

    if len(background_images) >= 2:
        break


background = torch.cat(
    background_images,
    dim=0
)[:8].to(DEVICE)


# SHAP prediction function
def model_predict(images):

    images = torch.tensor(
        images,
        dtype=torch.float32
    ).to(DEVICE)

    with torch.no_grad():

        outputs = model(
            images
        )

        probabilities = torch.softmax(
            outputs,
            dim=1
        )

    return probabilities.cpu().numpy()


# ============================================================
# CREATE SHAP EXPLAINER
# ============================================================

explainer = shap.DeepExplainer(
    model,
    background
)


# Select test images
test_images, test_labels = next(
    iter(test_loader)
)

test_images = test_images[
    :4
].to(DEVICE)


# Calculate SHAP values
shap_values = explainer.shap_values(
    test_images
)


# ============================================================
# SHAP VISUALIZATION
# ============================================================

images_for_plot = test_images.cpu().numpy()

images_for_plot = np.transpose(
    images_for_plot,
    (0, 2, 3, 1)
)


# Reverse normalization
mean = np.array(
    [0.485, 0.456, 0.406]
)

std = np.array(
    [0.229, 0.224, 0.225]
)

images_for_plot = (
    images_for_plot * std + mean
)

images_for_plot = np.clip(
    images_for_plot,
    0,
    1
)


shap.image_plot(
    shap_values,
    images_for_plot
)
